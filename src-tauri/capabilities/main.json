{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The server list window, which shows only the bundled frontend. Board windows match no capability and no remote origin is listed, so a board page can invoke nothing.",
  "windows": ["main"],
  "permissions": [
    "allow-list-servers",
    "allow-add-server",
    "allow-remove-server",
    "allow-rename-server",
    "allow-open-server",
    "allow-test-server",
    "allow-take-open-failure",
    "allow-failed-store-deletions",
    "allow-retry-store-deletion",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
